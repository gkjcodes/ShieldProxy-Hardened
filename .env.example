# ShieldProxy Environment Configuration Template
# NOTE: Use placeholders only. Never commit real secrets to source control.

# Application execution mode: development | test | protected
APP_MODE=development

# LLM Gateway Execution
USE_MOCK_LLM=true
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3
OPENAI_API_KEY=your-openai-api-key-placeholder

# Redis & Persistence
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED_IN_PROTECTED=false

# Rate Limiting
RATE_LIMIT_RPM=60

# Gateway Boundaries
MAX_BODY_SIZE_BYTES=65536
MAX_MESSAGE_LENGTH=2000
GATEWAY_TIMEOUT_SECONDS=15.0

# CORS Allowed Origins (Comma-separated, wildcards not permitted when credentials enabled)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API Key Registry (Format: key:tenant_id:role,key2:tenant2:role2)
# Roles: client | admin
# In development mode, default dev keys are provided if not set.
AUTH_KEY_REGISTRY=dev-client-key-placeholder:demo-tenant:client,dev-admin-key-placeholder:admin-tenant:admin